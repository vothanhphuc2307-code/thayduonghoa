# Required: Neon Postgres connection string.
DATABASE_URL="postgres://username:password@host.neon.tech/neondb"

# Optional emergency admin API secret. Never expose this in browser code.
ADMIN_TOKEN="replace-with-a-long-random-secret"

# Seed credentials are used only by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_STUDENT_EMAIL="student@example.com"
SEED_STUDENT_PASSWORD="change-me"

# App origin for future external callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
