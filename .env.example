# Copy this file to .env for local development. Never commit .env.
# For local PostgreSQL via Docker Compose:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dolthpt?sslmode=disable
# Replace with a random secret of at least 32 characters.
SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters
# The first admin account is created only by `npm run db:init`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPasswordBeforeRunning123!
# Optional; used for informational links only.
APP_ORIGIN=http://localhost:3000
